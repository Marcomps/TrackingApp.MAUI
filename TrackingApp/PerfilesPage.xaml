<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TrackingApp.ViewModels"
             xmlns:models="clr-namespace:TrackingApp.Models;assembly=TrackingApp.Core"
             x:Class="TrackingApp.PerfilesPage"
             x:DataType="viewmodels:PerfilesViewModel"
             Title="Perfiles"
             Shell.NavBarIsVisible="True">
    <ContentPage.Background>
        <SolidColorBrush Color="#F0F4F8"/>
    </ContentPage.Background>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Agregar" Command="{Binding AgregarCommand}" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header: Perfil activo ────────────────────────────────────── -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="20,24,20,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#A8C8E8" Offset="0.0"/>
                    <GradientStop Color="#C4B4F0" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Avatar activo -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        WidthRequest="56" HeightRequest="56"
                        StrokeThickness="0"
                        Margin="0,0,14,0"
                        VerticalOptions="Center">
                    <Border.Background>
                        <SolidColorBrush Color="#FFFFFF60"/>
                    </Border.Background>
                    <Label Text="{Binding EmojiActivoDisplay}"
                           FontSize="28"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                <!-- Nombre y tipo -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                    <Label Text="{Binding NombreActivoDisplay}"
                           FontSize="20" FontAttributes="Bold" TextColor="#3A3060"/>
                    <Label Text="{Binding TipoActivoDisplay}"
                           FontSize="13" TextColor="#7060B0"/>
                </VerticalStackLayout>
                <!-- Etiqueta Activo -->
                <Border Grid.Column="2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,5"
                        VerticalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#B8EDD5" Offset="0.0"/>
                            <GradientStop Color="#A8F0E4" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="ACTIVO" FontSize="11" TextColor="#2A6A50" FontAttributes="Bold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16" Spacing="0">

                <!-- ── Estado vacío ─────────────────────────────────────── -->
                <VerticalStackLayout IsVisible="{Binding NoHayPerfiles}"
                                     Spacing="14"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Margin="32,60">
                    <Label Text="👶" FontSize="56" HorizontalOptions="Center"/>
                    <Label Text="Aún no hay perfiles creados."
                           FontSize="15" TextColor="#888"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Button Text="+ Crear primer perfil"
                            Command="{Binding AgregarCommand}"
                            CornerRadius="12"
                            HorizontalOptions="Center"
                            TextColor="#3A3060"
                            Padding="24,12">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C4CAF5" Offset="0.0"/>
                                <GradientStop Color="#D8C0F0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </VerticalStackLayout>

                <!-- ── Sección: Perfil activo ───────────────────────────── -->
                <Label Text="PERFIL ACTIVO"
                       FontSize="11" TextColor="#888"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       Margin="4,0,0,8"
                       IsVisible="{Binding HayPerfiles}"/>

                <!-- ── Lista de perfiles ────────────────────────────────── -->
                <CollectionView ItemsSource="{Binding Perfiles}"
                                IsVisible="{Binding HayPerfiles}"
                                SelectionMode="Single"
                                SelectedItem="{Binding PerfilSeleccionado}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Perfil">
                            <SwipeView Margin="0,4">

                                <!-- Swipe: Eliminar -->
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Eliminar"
                                                   BackgroundColor="#FFC0CE"
                                                   CommandParameter="{Binding .}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PerfilesViewModel}}, Path=EliminarCommand}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Swipe: Editar -->
                                <SwipeView.LeftItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="Editar"
                                                   BackgroundColor="#B8D0F8"
                                                   CommandParameter="{Binding .}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PerfilesViewModel}}, Path=EditarCommand}" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>

                                <!-- Tarjeta de perfil -->
                                <Border StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        Padding="16,14">
                                    <Border.Background>
                                        <SolidColorBrush Color="White"/>
                                    </Border.Background>
                                    <Border.Shadow>
                                        <Shadow Brush="#C4B4F0" Offset="0,3" Radius="8" Opacity="0.20"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="Auto,*,Auto">

                                        <!-- Avatar -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 22"
                                                StrokeThickness="0"
                                                WidthRequest="50" HeightRequest="50"
                                                VerticalOptions="Center"
                                                Margin="0,0,14,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#C4CAF5" Offset="0.0"/>
                                                    <GradientStop Color="#D8C0F0" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Label Text="{Binding TipoPerfilEmoji}"
                                                   FontSize="24"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1"
                                                              VerticalOptions="Center"
                                                              Spacing="3">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#3A3060"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label FontSize="13" TextColor="#7060B0"
                                                   LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TipoPerfilDisplay}"/>
                                                        <Span Text=" · "/>
                                                        <Span Text="{Binding SexoDisplay}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="12" TextColor="#A080C0"
                                                   LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="🌐 "/>
                                                        <Span Text="{Binding SistemaUnidades}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Botón editar rápido -->
                                        <Button Grid.Column="2"
                                                Text="✏️"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PerfilesViewModel}}, Path=EditarCommand}"
                                                Background="Transparent"
                                                TextColor="#7060B0"
                                                FontSize="18"
                                                Padding="8,0"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </Border>

                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- ── Botón agregar nuevo perfil ──────────────────────── -->
                <Border StrokeShape="RoundRectangle 14"
                        StrokeThickness="1.5"
                        Margin="0,12,0,0"
                        Padding="16,14"
                        IsVisible="{Binding HayPerfiles}">
                    <Border.Stroke>
                        <SolidColorBrush Color="#C4B4F0"/>
                    </Border.Stroke>
                    <Border.Background>
                        <SolidColorBrush Color="Transparent"/>
                    </Border.Background>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="➕"
                               FontSize="22"
                               VerticalOptions="Center"
                               Margin="0,0,12,0"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Agregar nuevo perfil"
                                   FontSize="15" FontAttributes="Bold" TextColor="#7060B0"/>
                            <Label Text="Bebé, adulto, mascota u otro"
                                   FontSize="12" TextColor="#A080C0"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AgregarCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>

