<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TrackingApp.ViewModels"
             xmlns:models="clr-namespace:TrackingApp.Models;assembly=TrackingApp.Core"
             x:Class="TrackingApp.PerfilesPage"
             x:DataType="viewmodels:PerfilesViewModel"
             Title="Perfiles"
             Background="#f5f7fa">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding AgregarCommand}" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Header: Perfil activo ────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#2a3d66"
                StrokeThickness="0"
                Padding="16,14"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <!-- Icono -->
                <Label Grid.RowSpan="2" Grid.Column="0"
                       Text="👤"
                       FontSize="36"
                       VerticalOptions="Center"
                       Margin="0,0,12,0"/>
                <!-- Nombre y tipo -->
                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding NombreActivoDisplay}"
                       FontSize="18" FontAttributes="Bold" TextColor="White"/>
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding TipoActivoDisplay}"
                       FontSize="13" TextColor="#90CAF9"/>
                <!-- Etiqueta Activo -->
                <Border Grid.RowSpan="2" Grid.Column="2"
                        Background="#4CAF50"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        Padding="10,4"
                        VerticalOptions="Center">
                    <Label Text="ACTIVO" FontSize="11" TextColor="White" FontAttributes="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── Estado vacío ─────────────────────────────────────────────── -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding NoHayPerfiles}"
                             Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Margin="32,40">
            <Label Text="👤" FontSize="48" HorizontalOptions="Center"/>
            <Label Text="Aún no hay perfiles creados."
                   FontSize="15" TextColor="#888"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            <Button Text="+ Crear primer perfil"
                    Command="{Binding AgregarCommand}"
                    Background="#2a3d66"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Center"
                    Padding="20,10"/>
        </VerticalStackLayout>

        <!-- ── Lista de perfiles ────────────────────────────────────────── -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Perfiles}"
                        IsVisible="{Binding HayPerfiles}"
                        SelectionMode="Single"
                        SelectedItem="{Binding PerfilSeleccionado}"
                        Margin="0,4">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Perfil">
                    <SwipeView Margin="12,4">

                        <!-- Swipe: Eliminar -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="#F44336"
                                           CommandParameter="{Binding .}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PerfilesViewModel}}, Path=EliminarCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- Swipe: Editar -->
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Editar"
                                           BackgroundColor="#1976D2"
                                           CommandParameter="{Binding .}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PerfilesViewModel}}, Path=EditarCommand}" />
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <!-- Tarjeta de perfil -->
                        <Border Background="White"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#e0e0e0"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">

                                <!-- Avatar -->
                                <Border Grid.RowSpan="3" Grid.Column="0"
                                        Background="#e8edf5"
                                        StrokeShape="RoundRectangle 24"
                                        StrokeThickness="0"
                                        WidthRequest="48" HeightRequest="48"
                                        VerticalOptions="Center"
                                        Margin="0,0,12,0">
                                    <Label Text="{Binding TipoPerfilEmoji}"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Nombre -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="#1a1a2e"
                                       LineBreakMode="TailTruncation"/>

                                <!-- Tipo + sexo -->
                                <Label Grid.Row="1" Grid.Column="1"
                                       FontSize="13" TextColor="#666"
                                       LineBreakMode="TailTruncation">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TipoPerfilDisplay}"/>
                                            <Span Text=" · "/>
                                            <Span Text="{Binding SexoDisplay}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Edad (si aplica) -->
                                <Label Grid.Row="2" Grid.Column="1"
                                       FontSize="12" TextColor="#999"
                                       LineBreakMode="TailTruncation">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding SistemaUnidades, StringFormat='🌐 {0}'}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Botón editar rápido -->
                                <Button Grid.RowSpan="3" Grid.Column="2"
                                        Text="✏️"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PerfilesViewModel}}, Path=EditarCommand}"
                                        Background="Transparent"
                                        TextColor="#1976D2"
                                        FontSize="18"
                                        Padding="8,0"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
