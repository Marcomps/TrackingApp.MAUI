<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackingApp.MenuPage"
             Title="Seguimiento"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <Grid.Background>
            <SolidColorBrush Color="#F0F4F8"/>
        </Grid.Background>

        <!-- Header con gradiente pastel -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="20,50,20,30">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#A8C8E8" Offset="0.0"/>
                    <GradientStop Color="#C4B4F0" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                    <Label Text="Seguimiento"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#3A3060"/>
                    <Label Text="Tu salud en un solo lugar"
                           FontSize="13"
                           TextColor="#7060B0"/>
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 25"
                        WidthRequest="50"
                        HeightRequest="50"
                        StrokeThickness="0">
                    <Border.Background>
                        <SolidColorBrush Color="#FFFFFF60"/>
                    </Border.Background>
                    <Label Text="&#x1F464;"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Grid de Opciones (3x2) -->
        <ScrollView Grid.Row="1" Padding="20,20">
            <Grid RowDefinitions="*,*,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="16"
                  ColumnSpacing="16">

                <!-- Crecimiento -->
                <Border Grid.Row="0" Grid.Column="0"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#B8EDD5" Offset="0.0"/>
                            <GradientStop Color="#A8F0E4" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#88D4B4" Offset="0,4" Radius="10" Opacity="0.30"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="72"
                                HeightRequest="72"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,16">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF60"/>
                            </Border.Background>
                            <Label Text="&#x1F4CF;"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Crecimiento"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#2A6A50"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCrecimientoTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Alimento -->
                <Border Grid.Row="0" Grid.Column="1"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD9A8" Offset="0.0"/>
                            <GradientStop Color="#FFEAA8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#F0B870" Offset="0,4" Radius="10" Opacity="0.30"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="72"
                                HeightRequest="72"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,16">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF60"/>
                            </Border.Background>
                            <Label Text="&#x1F37C;"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Alimento"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#7A5000"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlimentoTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Salud -->
                <Border Grid.Row="1" Grid.Column="0"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFC0CE" Offset="0.0"/>
                            <GradientStop Color="#D4A8E8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#E090B0" Offset="0,4" Radius="10" Opacity="0.30"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="72"
                                HeightRequest="72"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,16">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF60"/>
                            </Border.Background>
                            <Label Text="&#x1F48A;"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Salud"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#7A2050"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaludTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Citas Medicas -->
                <Border Grid.Row="1" Grid.Column="1"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#B8D0F8" Offset="0.0"/>
                            <GradientStop Color="#CEB8F8" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#90A8E8" Offset="0,4" Radius="10" Opacity="0.30"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="72"
                                HeightRequest="72"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,16">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF60"/>
                            </Border.Background>
                            <Label Text="&#x1F4C5;"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Citas Médicas"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#303888"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCitasMedicasTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Gráficas -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0"
                        Padding="0"
                        Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C4CAF5" Offset="0.0"/>
                            <GradientStop Color="#D8C0F0" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#A8A8E0" Offset="0,4" Radius="10" Opacity="0.30"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" Padding="20" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="60"
                                HeightRequest="60"
                                StrokeThickness="0">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF60"/>
                            </Border.Background>
                            <Label Text="&#x1F4CA;"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label Text="Gráficas"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#3A3070"/>
                            <Label Text="Alimento • Medicamento • Crecimiento • Citas"
                                   FontSize="12"
                                   TextColor="#7060A8"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGraficasTapped"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>
        </ScrollView>

    </Grid>

</ContentPage>