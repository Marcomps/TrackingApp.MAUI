<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackingApp.MenuPage"
             Title="Seguimiento"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                Padding="20,40,20,20"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Seguimiento"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#333"
                       VerticalOptions="Center"/>
                <Border Grid.Column="1"
                        Background="#E8F4F8"
                        StrokeShape="RoundRectangle 25"
                        WidthRequest="50"
                        HeightRequest="50"
                        StrokeThickness="0">
                    <Label Text="&#x1F464;"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Grid de Opciones (2x2) -->
        <ScrollView Grid.Row="1" Padding="20,20">
            <Grid RowDefinitions="*,*"
                  ColumnDefinitions="*,*"
                  RowSpacing="20"
                  ColumnSpacing="20">

                <!-- Crecimiento -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="White"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#E0E0E0" Offset="0,2" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                Background="#E8F4F8"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="80"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,20">
                            <Label Text="&#x1F4CF;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Crecimiento"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#666"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCrecimientoTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Alimento -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="White"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#E0E0E0" Offset="0,2" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                Background="#E8F4F8"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="80"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,20">
                            <Label Text="&#x1F37C;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Alimento"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#666"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlimentoTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Salud -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="White"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#E0E0E0" Offset="0,2" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                Background="#E8F4F8"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="80"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,20">
                            <Label Text="&#x1F48A;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Salud"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#666"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaludTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Citas Medicas -->
                <Border Grid.Row="1" Grid.Column="1"
                        Background="White"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="#E0E0E0" Offset="0,2" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="*,Auto" Padding="20">
                        <Border Grid.Row="0"
                                Background="#E8F4F8"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="80"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                StrokeThickness="0"
                                Margin="0,10,0,20">
                            <Label Text="&#x1F4C5;"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Citas Medicas"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#666"
                               HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCitasMedicasTapped"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>
        </ScrollView>

    </Grid>

</ContentPage>