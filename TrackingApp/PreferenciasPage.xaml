<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TrackingApp.ViewModels"
             x:Class="TrackingApp.PreferenciasPage"
             x:DataType="viewmodels:PreferenciasViewModel"
             Title="Ajustes de Unidades"
             Background="#f5f7fa">

    <ContentPage.BindingContext>
        <viewmodels:PreferenciasViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="16,16">

            <!-- ── Banner informativo ─────────────────────────────────────── -->
            <Border Background="#2a3d66"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="16,14"
                    Margin="0,0,0,20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="⚙️" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Unidades de medida"
                               FontSize="16" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Personaliza las unidades por defecto para peso, talla y volumen."
                               FontSize="12" TextColor="#90CAF9"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ── Sistema general ───────────────────────────────────────── -->
            <Label Text="SISTEMA GENERAL" FontSize="11" TextColor="#888"
                   FontAttributes="Bold" Margin="0,0,0,6" CharacterSpacing="1"/>

            <Border Background="White" StrokeShape="RoundRectangle 10"
                    Stroke="#e0e0e0" Padding="14,8" Margin="0,0,0,20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="🌐" FontSize="20" VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding OpcionesSistema}"
                            SelectedIndex="{Binding SistemaIndex}"
                            FontSize="15"
                            TextColor="#2a3d66"
                            HorizontalOptions="Fill"/>
                </Grid>
            </Border>

            <!-- ── Peso ──────────────────────────────────────────────────── -->
            <Label Text="UNIDAD DE PESO" FontSize="11" TextColor="#888"
                   FontAttributes="Bold" Margin="0,0,0,6" CharacterSpacing="1"/>

            <Border Background="White" StrokeShape="RoundRectangle 10"
                    Stroke="#e0e0e0" Padding="14,8" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="⚖️" FontSize="20" VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding OpcionesPeso}"
                            SelectedIndex="{Binding UnidadPesoIndex}"
                            FontSize="15"
                            TextColor="#2a3d66"
                            HorizontalOptions="Fill"/>
                </Grid>
            </Border>
            <Label Text="{Binding EjemploPeso}"
                   FontSize="12" TextColor="#777" Margin="14,0,0,16"/>

            <!-- ── Talla ──────────────────────────────────────────────────── -->
            <Label Text="UNIDAD DE TALLA / LONGITUD" FontSize="11" TextColor="#888"
                   FontAttributes="Bold" Margin="0,0,0,6" CharacterSpacing="1"/>

            <Border Background="White" StrokeShape="RoundRectangle 10"
                    Stroke="#e0e0e0" Padding="14,8" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="📏" FontSize="20" VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding OpcionesTalla}"
                            SelectedIndex="{Binding UnidadTallaIndex}"
                            FontSize="15"
                            TextColor="#2a3d66"
                            HorizontalOptions="Fill"/>
                </Grid>
            </Border>
            <Label Text="{Binding EjemploTalla}"
                   FontSize="12" TextColor="#777" Margin="14,0,0,16"/>

            <!-- ── Volumen / Líquido ──────────────────────────────────────── -->
            <Label Text="UNIDAD DE VOLUMEN / LÍQUIDO" FontSize="11" TextColor="#888"
                   FontAttributes="Bold" Margin="0,0,0,6" CharacterSpacing="1"/>

            <Border Background="White" StrokeShape="RoundRectangle 10"
                    Stroke="#e0e0e0" Padding="14,8" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="🧪" FontSize="20" VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding OpcionesLiquido}"
                            SelectedIndex="{Binding UnidadLiquidoIndex}"
                            FontSize="15"
                            TextColor="#2a3d66"
                            HorizontalOptions="Fill"/>
                </Grid>
            </Border>
            <Label Text="{Binding EjemploLiquido}"
                   FontSize="12" TextColor="#777" Margin="14,0,0,28"/>

            <!-- ── Botones ───────────────────────────────────────────────── -->
            <Button Text="💾 Guardar preferencias"
                    Command="{Binding GuardarCommand}"
                    Background="#2a3d66"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="52"
                    Margin="0,0,0,10"/>

            <Button Text="↩ Restablecer valores guardados"
                    Command="{Binding RestablecerCommand}"
                    Background="#e0e0e0"
                    TextColor="#555"
                    FontSize="14"
                    CornerRadius="10"
                    HeightRequest="46"
                    Margin="0,0,0,20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
